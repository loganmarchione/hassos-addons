{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:nonOfficeHours",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "America/New_York",
  "dependencyDashboard": {
    "enabled": true,
    "title": "Renovate Dashboard"
  },
  "labels": [
    "renovatebot"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\n(?:ARG|ENV)\\s+\\w+=[\"']?(?<currentValue>[\\w.-]+)[\"']?"
      ],
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ]
}
